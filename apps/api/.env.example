APP_NAME=Elite Task API
# development | production. В production приложение не стартует со слабым JWT_SECRET,
# CORS_ORIGINS=* или AUTO_SEED=true.
ENVIRONMENT=development
DATABASE_URL=sqlite+aiosqlite:///./data/elite_task.db

# Не менее 32 случайных символов:
# python -c "from app.config import generate_secret; print(generate_secret())"
JWT_SECRET=change-me-before-deploy-use-at-least-32-random-characters
JWT_EXPIRE_MINUTES=1440
# Одноразовый билет для WebSocket живёт секунды, а не сутки, как JWT.
WS_TICKET_EXPIRE_SECONDS=60

# Через запятую. Порты Expo Web (8081, 19006) и обычного dev-сервера (3000).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:3000

# Демо-данные (выключить в production).
AUTO_SEED=true
# Открытая регистрация личных аккаунтов (роль personal).
ALLOW_REGISTRATION=true

# Ограничение перебора паролей: N неудачных попыток за окно (секунды) на email+IP.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Вложения задач.
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
