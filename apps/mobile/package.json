{
  "name": "elite-task-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "expo start",
    "start:lts": "npm exec --yes --package=node@22 -- node ./node_modules/expo/bin/cli start --max-workers 1",
    "web:lts": "npm exec --yes --package=node@22 -- node ./node_modules/expo/bin/cli start --web --max-workers 1",
    "doctor:lts": "npm exec --yes --package=node@22 -- node ./node_modules/expo-doctor/bin/expo-doctor.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:android:lts": "npm exec --yes --package=node@22 -- node ./node_modules/expo/bin/cli export --platform android --output-dir dist --max-workers 1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "^58.0.22",
    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "expo-doctor": "^1.21.5",
    "typescript": "~6.0.3"
  }
}
